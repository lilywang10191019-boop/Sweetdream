// 确定性随机数生成器，确保相同种子得到相同结果
const seededRandom = (seed: string) => {
  let h = 0;
  for (let i = 0; i < seed.length; i++) h = Math.imul(31, h) + seed.charCodeAt(i) | 0;
  return () => {
    h = Math.imul(1597334677, h);
    h = h >>> 0;
    return (h ^ (h >>> 16)) / 4294967296;
  };
};



import React, { useState } from 'react';
import { Participant } from '../types';
import { KeyRound, Users, ChevronRight, Share2, QrCode } from 'lucide-react';
import { QRCodeSVG } from 'qrcode.react';

interface SetupProps {
  defaultRoomKey: string;
  participants: Participant[];
  onJoin: (key: string) => void;
}

export const Setup: React.FC<SetupProps> = ({ defaultRoomKey, onJoin, participants }) => {
  const [key, setKey] = useState(defaultRoomKey);
  const [showQR, setShowQR] = useState(false);

  const getShareUrl = () => {
    const url = new URL(window.location.href);
    url.searchParams.set('room', key);
    return url.toString();
  };

  const copyLink = () => {
    navigator.clipboard.writeText(getShareUrl());
    alert('专属链接已复制！发给微信好友，他们点击就能直接进入房间。');
  };

  return (
    <div className="space-y-6 animate-in fade-in slide-in-from-bottom-6 duration-500">
      <div className="bg-slate-800/50 border border-slate-700 rounded-2xl p-6 shadow-2xl backdrop-blur-md">
        <div className="flex items-center gap-2 mb-6 text-indigo-400">
          <KeyRound className="w-5 h-5" />
          <h2 className="font-semibold text-lg">设置群组暗号</h2>
        </div>
        
        <input
          type="text"
          value={key}
          onChange={(e) => setKey(e.target.value)}
          className="w-full bg-slate-900 border-2 border-slate-700 rounded-xl px-5 py-4 text-xl font-mono text-indigo-400 focus:border-indigo-500 outline-none transition-all text-center uppercase"
        />

        <div className="mt-6 flex gap-3">
          <button
            onClick={copyLink}
            className="flex-1 py-3 bg-slate-700 hover:bg-slate-600 rounded-xl text-sm font-bold flex items-center justify-center gap-2 transition-colors"
          >
            <Share2 className="w-4 h-4" />
            复制邀请链接
          </button>
          <button
            onClick={() => setShowQR(!showQR)}
            className="px-4 py-3 bg-slate-700 hover:bg-slate-600 rounded-xl transition-colors"
          >
            <QrCode className="w-5 h-5" />
          </button>
        </div>

        {showQR && (
          <div className="mt-6 flex flex-col items-center p-4 bg-white rounded-xl animate-in zoom-in-95">
            <QRCodeSVG value={getShareUrl()} size={160} />
            <p className="text-slate-900 text-xs font-bold mt-2">让朋友扫码加入</p>
          </div>
        )}
      </div>

      <div className="bg-slate-800/30 border border-slate-700/50 rounded-2xl p-6">
        <div className="flex items-center gap-2 mb-4 text-slate-400">
          <Users className="w-5 h-5" />
          <h2 className="font-medium">参与成员 ({participants.length}人)</h2>
        </div>
        <div className="flex flex-wrap gap-2">
          {participants.map(p => (
            <span key={p.id} className="px-3 py-1 bg-slate-700/50 rounded-full text-xs text-slate-300 border border-slate-600">
              {p.name}
            </span>
          ))}
        </div>
      </div>

      <button
        onClick={() => onJoin(key)}
        className="w-full py-4 bg-gradient-to-r from-indigo-500 to-pink-500 rounded-2xl font-bold text-xl flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/20 transform active:scale-95 transition-all hover:brightness-110"
      >
        进入抽签
        <ChevronRight className="w-6 h-6" />
      </button>
    </div>
  );
};
